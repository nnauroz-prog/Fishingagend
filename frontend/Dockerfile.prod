# --- Build-Stufe ---
FROM node:20-alpine AS bauer

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

ARG VITE_API_BASIS=http://localhost:8000
ENV VITE_API_BASIS=$VITE_API_BASIS

RUN npm run build

# --- Auslieferungs-Stufe ---
FROM nginx:alpine

COPY --from=bauer /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
